.DS_Store
Thumbs.db
desktop.ini

# ---- engine run data ----------------------------------------------------
# Live run event logs are transient and can be regenerated from (scenario,
# seed, policy). Aggregate experiment results and the capability report are
# evidence and ARE tracked.
data/runs/
data/**/events.jsonl
!data/experiments/
!data/evidence/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.sqlite
*.sqlite-journal

# ---- demo video intermediates ------------------------------------------
# Frame sequences and rendered stills are large and fully regenerable from
# video/timeline.json plus the recorded runs. The finished MP4, the poster,
# the contact sheet, the SRT and every manifest ARE tracked.
video/frames/
video/renders/
video/audio/
video/work/

# ---- static export for the public deployment ---------------------------
# Regenerated by: npm run deploy (or npm run deploy -- --dry)
apps/web/out/
# wrangler dev's local state
.wrangler/

# ---- the story film (/brag) ----------------------------------------------
# The plan, share copy, poster, composition, scripts, telemetry and voice
# timings are tracked; the site's copy of the film is in apps/web/public/video.
# Frames, stills, stems, review images and the 103 MB master are regenerable
# from those scripts and stay local.
brag-output/brag.mp4
brag-output/work/frames/
brag-output/work/stills/
brag-output/work/web/
brag-output/work/vo/
brag-output/work/vo16/
brag-output/work/*.wav
brag-output/work/*.png
brag-output/work/*.jpg
brag-output/work/*.log
brag-output/work/loud*.json
brag-output/work/telemetry-proof.json

# ---- the intro and the walkthrough (/brag, 2026-10-06) ------------------------
# Plan, brief, share copy, poster, both compositions, captions, scripts and
# timings are tracked; the site's copy of the intro is in apps/web/public/video.
# Footage, frames, voice stems, renders and review images are regenerable from
# those scripts and stay local.
brag-output-2026-10-06-230856/*.mp4
brag-output-2026-10-06-230856/composition/assets/*
!brag-output-2026-10-06-230856/composition/assets/continua-logo.png
brag-output-2026-10-06-230856/composition/snapshots/
brag-output-2026-10-06-230856/walkthrough/assets/
brag-output-2026-10-06-230856/work/frames/
# Voice: the clips stay local; each set's take record (every take's transcript) is kept.
brag-output-2026-10-06-230856/work/vo/*
!brag-output-2026-10-06-230856/work/vo/intro/
!brag-output-2026-10-06-230856/work/vo/walkthrough/
!brag-output-2026-10-06-230856/work/vo/demo/
brag-output-2026-10-06-230856/work/vo/*/*
!brag-output-2026-10-06-230856/work/vo/*/takes.json
brag-output-2026-10-06-230856/work/*.wav
brag-output-2026-10-06-230856/work/*.jpg
brag-output-2026-10-06-230856/work/*.log
brag-output-2026-10-06-230856/work/*.mp4
**/.brag.hf-transaction-*/

