# ---- dependencies ----
node_modules/
.pnp/
.pnp.js
.yarn/

# ---- next.js / build output ----
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ---- secrets / env ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ---- private MCP / editor settings ----
.mcp.json
.claude/settings.local.json
.vscode/
.idea/

# ---- checkpoint supervisor (must stay untracked: it logs its own commits) ----
.checkpoint/

# ---- blender temporaries / backups ----
*.blend1
*.blend2
*.blend@
blender_autosave/

# ---- render intermediates ----
renders/frames/
renders/tmp/
*.exr
assets/previews/frames/

# ---- test / tooling output ----
coverage/
playwright-report/
test-results/
tests/output/
.playwright/

# ---- os noise ----
.DS_Store
Thumbs.db
desktop.ini

# ---- engine run data ----------------------------------------------------
# Live run event logs are transient and can be regenerated from (scenario,
# seed, policy). Aggregate experiment results and the capability report are
# evidence and ARE tracked.
data/runs/
data/**/events.jsonl
!data/experiments/
!data/evidence/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.sqlite
*.sqlite-journal

# ---- demo video intermediates ------------------------------------------
# Frame sequences and rendered stills are large and fully regenerable from
# video/timeline.json plus the recorded runs. The finished MP4, the poster,
# the contact sheet, the SRT and every manifest ARE tracked.
video/frames/
video/renders/
video/audio/
video/work/
