{
  "name": "continua",
  "version": "0.1.0",
  "private": true,
  "description": "CONTINUA \u2014 Predictive Network Continuity. Interactive 3D mission scene by Team Kanban.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/4waiz/CONTINUA.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "blender:all": "npm run blender:vehicle && npm run blender:props && npm run blender:previews",
    "blender:previews": "node scripts/run-blender.mjs scripts/blender/render_previews.py",
    "blender:props": "node scripts/run-blender.mjs scripts/blender/build_props.py",
    "blender:vehicle": "node scripts/run-blender.mjs scripts/blender/build_vehicle.py",
    "build": "npm run build --workspace=@continua/web",
    "checkpoint:once": "python scripts/checkpoint.py once",
    "checkpoint:start": "python scripts/checkpoint.py start",
    "checkpoint:status": "python scripts/checkpoint.py status",
    "checkpoint:stop": "python scripts/checkpoint.py stop",
    "dev": "npm run dev --workspace=@continua/web",
    "emulation:capability": "python scripts/engine_cli.py continua_engine.emulation.capability",
    "emulation:status": "python scripts/engine_cli.py continua_engine.emulation.adapter status",
    "engine": "python -m uvicorn continua_engine.api.app:app --host 127.0.0.1 --port 8000 --app-dir services/engine",
    "experiment": "python scripts/engine_cli.py continua_engine.experiments --trials 20 --block test",
    "experiment:smoke": "python scripts/engine_cli.py continua_engine.experiments --smoke",
    "lint": "eslint apps packages tests --max-warnings=0",
    "start": "npm run start --workspace=@continua/web",
    "test:engine": "pytest tests/engine -q",
    "test:perf": "playwright test --config=tests/playwright.config.ts --project=gpu --grep \"measures rendering performance\"",
    "test:phase2": "playwright test --config=tests/playwright.config.ts --project=desktop-1920 tests/phase2.spec.ts",
    "test:smoke": "playwright test --config=tests/playwright.config.ts --project=desktop-1920 --project=desktop-1440 --project=desktop-1280 tests/scene.spec.ts tests/evidence.spec.ts",
    "train:predictor": "python scripts/engine_cli.py continua_engine.controller.train_predictor --trials 5",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "video:build": "node scripts/build-demo.mjs",
    "video:capture": "node scripts/capture-demo.mjs",
    "video:capture:test": "node scripts/capture-demo.mjs --test",
    "video:cards": "python scripts/build_video_cards.py",
    "video:claims": "node scripts/check-claims.mjs",
    "video:narration": "node scripts/build-narration.mjs",
    "video:qa": "node scripts/qa-demo.mjs",
    "video:renders": "node scripts/run-blender.mjs scripts/blender/render_video_shots.py"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3"
  }
}
