# CONTINUA — example environment file.
# Copy to `.env.local` (inside apps/web) or `.env` (repo root) and fill in.
# NEVER commit the filled-in copy. `.env*` is git-ignored except this example.

# ---------------------------------------------------------------------------
# Phase 1 (scene foundation) needs NO secrets. Everything below is either
# optional tooling configuration or a placeholder reserved for Phase 2/3.
# ---------------------------------------------------------------------------

# --- Local tooling paths (optional; scripts auto-detect when unset) ---------
# Absolute path to the Blender executable used by scripts/blender/*.py
CONTINUA_BLENDER=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe

# Absolute path to ffmpeg, used by the Phase 3 video capture pipeline.
CONTINUA_FFMPEG=ffmpeg

# --- Web app -----------------------------------------------------------------
# Base URL used by the Playwright smoke tests.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shown in the scene HUD. Phase 1 must stay "preview"; Phase 2 may set "live".
NEXT_PUBLIC_CONTINUA_MODE=preview

# --- Phase 2 placeholders (unused in Phase 1) --------------------------------
# Endpoint of the predictive network-continuity engine.
# CONTINUA_ENGINE_URL=
# CONTINUA_ENGINE_TOKEN=

# --- Checkpoint supervisor ---------------------------------------------------
# Branch the 300s checkpoint supervisor pushes to.
CONTINUA_CHECKPOINT_BRANCH=continua/build
# Seconds between checkpoint attempts.
CONTINUA_CHECKPOINT_INTERVAL=300
