d","wifi","cellular","satellite"],"workload":["control","telemetry","video","voice","bulk"],"faults":[],"background":[]},{"id":"wifi-degradation","title":"Gradual Wi-Fi degradation, cellular overlapping","family":"degradation","description":"Wi-Fi quality decays smoothly over 22 s while the rover is still inside cellular coverage. The canonical case for prediction: the failure is visible in the trend well before it becomes a violation.","duration_s":105,"speed_scale":1.0,"reverse":false,"links":["wired","wifi","cellular","satellite"],"workload":["control","telemetry","video","voice","bulk"],"faults":[{"link":"wifi","kind":"degrade","start_s":26.0,"ramp_s":22.0,"duration_s":34.0,"severity":0.94}],"background":[]},{"id":"sudden-failure","title":"Sudden Wi-Fi failure without warning","family":"sudden","description":"Wi-Fi drops to zero in 200 ms with no preceding trend. Prediction cannot help here; the honest expectation is that CONTINUA performs like a good reactive policy, and the experiment is designed to show that.","duration_s":105,"speed_scale":1.0,"reverse":false,"links":["wired","wifi","cellular","satellite"],"workload":["control","telemetry","video","voice","bulk"],"faults":[{"link":"wifi","kind":"outage","start_s":32.0,"ramp_s":0.2,"duration_s":40.0,"severity":1.0}],"background":[]},{"id":"cellular-congestion","title":"Cellular congestion","family":"congestion","description":"Competing background demand consumes most of the cellular cell's capacity for 30 s. Availability stays high, so a coverage-only policy sees nothing wrong while queues build.","duration_s":105,"speed_scale":1.0,"reverse":false,"links":["wired","wifi","cellular","satellite"],"workload":["control","telemetry","video","voice","bulk"],"faults":[],"background":[{"link":"cellular","start_s":46.0,"ramp_s":4.0,"duration_s":30.0,"load":0.86}]},{"id":"satellite-fallback","title":"Satellite fallback in the remote sector","family":"fallback","description":"Cellular fades out early, forcing the satell