# Cloudflare static-asset headers. `next.config.ts` drops its `headers()` block
# in the static export (there is no server to run it), so the caching policy
# lives here instead.

/models/*
  Cache-Control: public, max-age=31536000, immutable

/reference/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
